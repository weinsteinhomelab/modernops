# Client demo gate: every request under /demos/ goes through index.php (password per company, attempt limit per IP).
# The demo sites themselves are outside public_html (../../demos-private) and are not in this repository.
Options -Indexes
DirectoryIndex index.php
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai"
</IfModule>
RewriteEngine On
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^ index.php [L]
