# Modern Ops HQ — environment
# Copy to ".env" (same folder) and fill in. Keep .env private (it's gitignored).

# Port the dashboard listens on (on the Zima box). Change if 8090 is taken.
APP_PORT=8090

# Database (these are internal to Docker — pick strong values, save them somewhere safe)
DB_NAME=modernops_hq
DB_USER=hq
DB_PASS=CHANGE_ME_to_a_strong_password
DB_ROOT_PASS=CHANGE_ME_to_another_strong_password

# Random long string for session security
APP_SECRET=CHANGE_ME_to_a_long_random_string

# Where new website-lead emails go, and which site may post to the form API
NOTIFY_EMAIL=info@modern-ops.net
SITE_ORIGIN=https://modern-ops.net

# Outgoing email for sending quotes (Phase 2 — can leave SMTP_PASS blank for now)
SMTP_HOST=mail.modern-ops.net
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=info@modern-ops.net
SMTP_PASS=
MAIL_FROM=info@modern-ops.net
MAIL_FROM_NAME=Modern Ops

# Quotes are sent from this mailbox (same shared password as the others)
QUOTE_SMTP_USER=quotes@modern-ops.net
QUOTE_MAIL_FROM=quotes@modern-ops.net
QUOTE_MAIL_FROM_NAME=Modern Ops Quotes

# Reading mail (IMAP) for the Email tab — all accounts share SMTP_PASS
IMAP_HOST=mail.modern-ops.net
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
MAIL_ACCOUNTS=peter@modern-ops.net,info@modern-ops.net,service@modern-ops.net,quotes@modern-ops.net

# Cloudflare Tunnel token (only if you uncomment the cloudflared service)
TUNNEL_TOKEN=
