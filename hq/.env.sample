# HQ — environment (secrets + infrastructure only)
# Copy to ".env" (same folder) and fill in. Keep .env private (it's gitignored).
# Everything else about the client (name, colors, email addresses, tax, quote
# terms, products) lives in app/clients/<CLIENT>.php.

# Which client file to use: app/clients/<CLIENT>.php
CLIENT=modernops

# Port the dashboard listens on. Change if 8090 is taken.
APP_PORT=8090

# Database (internal to Docker — pick strong values, save them somewhere safe)
DB_NAME=hq
DB_USER=hq
DB_PASS=CHANGE_ME_to_a_strong_password
DB_ROOT_PASS=CHANGE_ME_to_another_strong_password

# Random long string for session security
APP_SECRET=CHANGE_ME_to_a_long_random_string

# The one password shared by every mailbox in the client file (sending + Ops Inbox)
SMTP_PASS=

# Cloudflare Tunnel token (only if you use the cloudflared service)
TUNNEL_TOKEN=
